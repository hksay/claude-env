# Claude Code — provider blocks for cc.sh
#
# Usage: copy to ~/.env or <repo>/.env (cc.sh prefers ~/.env if it exists).
# Run: ./cc.sh (uses DEFAULT_PROVIDER) or ./cc.sh -b <glm|minimax|kimi|qwen|volcengine> (-b: not -p; claude -p is --print)
#
# Global defaults (used for every provider unless overridden):
DEFAULT_PROVIDER=glm
API_TIMEOUT_MS=3000000
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
#
# Per provider (PREFIX = GLM, MINIMAX, KIMI, QWEN, VOLCENGINE): PREFIX_API_KEY, PREFIX_API_BASE_URL,
# [PREFIX_MODEL], and optional overrides PREFIX_API_TIMEOUT_MS, PREFIX_CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC.
# PREFIX_MODEL: if unset or empty, cc.sh does not pass ANTHROPIC_* model variables into the container.
# You may delete unused provider sections or leave placeholders; they are ignored until you use -b <provider>.
#
# Shared Docker image: claude-dev-container (same image for every provider).
# If cc.sh is a copy in $HOME (not a symlink into this repo), set the build context explicitly:
# CC_DOCKERFILE_DIR=/absolute/path/to/claude-env/docker

# --- glm (default: ./cc.sh or ./cc.sh -b glm) ---
GLM_API_KEY=
GLM_API_BASE_URL=https://open.bigmodel.cn/api/anthropic
GLM_MODEL=glm-5.1

# --- minimax ---
MINIMAX_API_KEY=
MINIMAX_API_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_MODEL=MiniMax-M2.7

# --- kimi ---
KIMI_API_KEY=
KIMI_API_BASE_URL=https://api.kimi.com/coding/
KIMI_MODEL=kimi-for-coding

# --- qwen ---
QWEN_API_KEY=
QWEN_API_BASE_URL=https://coding.dashscope.aliyuncs.com/apps/anthropic
QWEN_MODEL=qwen3.5-plus

# --- volcengine (Ark) ---
VOLCENGINE_API_KEY=
VOLCENGINE_API_BASE_URL=https://ark.cn-beijing.volces.com/api/coding
VOLCENGINE_MODEL=ark-code-latest
